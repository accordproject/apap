NODE_ENV=development

# POSTGRES_URL=postgresql://<user>:<pass>@<host>/<database>?sslmode=require

# OR YOU CAN DO IT LIKE THIS
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=1baddeed
POSTGRES_PORT=5432

# APAP API Base URL (defaults to localhost:9000 if not set)
APAP_API_BASE_URL=http://localhost:9000

# APAP API Authorization Header (optional - for authenticated API calls)
# Examples:
# APAP_API_AUTH_HEADER=Bearer your-jwt-token-here
# APAP_API_AUTH_HEADER=Basic base64-encoded-credentials
# APAP_API_AUTH_HEADER=ApiKey your-api-key-here

# Public origin advertised by the A2A discovery card.
# Required in production; defaults to http://HOST:PORT in development/test.
PUBLIC_BASE_URL=http://localhost:9000

# A2A authentication. `none` is for development/test only and production
# fails closed if AUTH_ADAPTER is unset or `none`.
AUTH_ADAPTER=none

# Demo-grade HS256 reference adapter. Set AUTH_ADAPTER=hs256 to use it.
# For production, register an asymmetric OIDC/JWKS or wallet/DID adapter.
# A2A_JWT_SECRET=replace-with-at-least-32-characters
# A2A_JWT_ISSUER=https://issuer.example.com/
# A2A_JWT_AUDIENCE=apap-a2a
