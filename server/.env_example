# POSTGRES_URL=postgresql://<user>:<pass>@<host>/<database>?sslmode=require

# OR YOU CAN DO IT LIKE THIS
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=1baddeed
POSTGRES_PORT=5432

# APAP API Base URL (defaults to localhost:9000 if not set)
APAP_API_BASE_URL=http://localhost:9000

# APAP API Authorization Header (optional - for authenticated API calls)
# Examples:
# APAP_API_AUTH_HEADER=Bearer your-jwt-token-here
# APAP_API_AUTH_HEADER=Basic base64-encoded-credentials
# APAP_API_AUTH_HEADER=ApiKey your-api-key-here

# Legal Context Protocol (LCP) support — see server/README.md.
# Absolute https:// origin used to build every URL in an emitted LCP
# document. Required (and enforced as https) in any deployment reachable by
# an agent; without it, URLs fall back to the (non-compliant) inbound
# request protocol/host, which is only acceptable for local development.
# APAP_PUBLIC_BASE_URL=https://apap.example

# Root /.well-known/legal-context.json is opt-in and 404s unless configured
# via one of the following (LCP_TERMS_URL takes priority if both are set):
# LCP_TERMS_URL=https://apap.example/agreements/1/terms
# LCP_TERMS_HASH=0x<lowercase-sha256-of-served-bytes>
# LCP_TERMS_FORMAT=markdown
# LCP_API_URL=https://apap.example/
# LCP_ROOT_AGREEMENT_ID=1